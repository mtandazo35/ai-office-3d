# Copia este archivo como .env y ajusta lo que necesites.

# Puerto local de la oficina (solo escucha en 127.0.0.1).
PUERTO=7777

# Carpeta de Claude Code del host. Por defecto ${HOME}/.claude.
# En Windows (Docker Desktop), por ejemplo: CLAUDE_DIR=C:/Users/manuel/.claude
#CLAUDE_DIR=/home/manuel/.claude

# Usuario con el que corre el contenedor. En Linux pon el tuyo para poder leer ~/.claude:
#   echo "UID_GID=$(id -u):$(id -g)" >> .env
UID_GID=1000:1000

# Minutos que un agente en modo guardia espera órdenes antes de quedar libre.
# Si lo cambias, vuelve a ejecutar el instalador (ajusta el timeout del hook Stop).
GUARDIA_MAX_MIN=14

# 1 = agentes simulados para probar la oficina sin Claude Code.
AI_OFFICE_DEMO=0
