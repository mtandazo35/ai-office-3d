# Copia este archivo como .env y ajusta lo que necesites. Lleva secretos:
#   cp .env.example .env && chmod 600 .env

# ---------- Acceso al panel ----------
# 127.0.0.1 = solo desde el propio equipo (entras con el enlace de un solo uso que sale en el log).
# 0.0.0.0   = desde la IP del VPS. Exige OFICINA_PASSWORD y activa HTTPS automáticamente.
PUBLICAR_IP=127.0.0.1
PUERTO=7777

# 1 = exige contraseña aunque PUBLICAR_IP sea 127.0.0.1. Necesario detrás de un proxy inverso (ver README).
ACCESO_REMOTO=0

# Obligatoria si PUBLICAR_IP no es 127.0.0.1 o si ACCESO_REMOTO=1 (mínimo 12 caracteres). Genera una con:
#   openssl rand -base64 24
OFICINA_PASSWORD=
# Alternativa a OFICINA_PASSWORD para que no aparezca en docker inspect: ruta del archivo DENTRO
# del contenedor, montado como secreto (ver README). Deja OFICINA_PASSWORD vacía: tiene prioridad.
#OFICINA_PASSWORD_FILE=/run/secrets/oficina_password

# HTTPS del panel:
#   (vacío) automático: autofirmado en modo VPS, HTTP en local
#   auto      certificado autofirmado para TLS_HOSTS (el navegador avisa una vez; acepta tras comprobar la huella del log)
#   archivos  tu certificado: TLS_CERT y TLS_KEY (rutas dentro del contenedor; monta la carpeta)
#   0         HTTP plano: solo si vas detrás de un proxy con HTTPS (Nginx Proxy Manager, Caddy…)
TLS=
# IP pública y/o dominio del VPS para el certificado autofirmado. Ej.: TLS_HOSTS=203.0.113.10,oficina.midominio.com
TLS_HOSTS=
#TLS_CERT=/certs/fullchain.pem
#TLS_KEY=/certs/privkey.pem

# 1 si la oficina va detrás de un proxy inverso (usa X-Forwarded-For/Proto para IP y cookies Secure).
CONFIAR_PROXY=0

# ---------- Claude Code ----------
# Puerto donde la oficina recibe los hooks. Siempre publicado solo en 127.0.0.1.
PUERTO_HOOKS=7778

# Carpeta de Claude Code del usuario que trabaja con Claude en este equipo. Por defecto ${HOME}/.claude.
#CLAUDE_DIR=/home/usuario/.claude

# Usuario con el que corre el contenedor. En Linux pon el tuyo para poder leer ~/.claude:
#   echo "UID_GID=$(id -u):$(id -g)" >> .env
UID_GID=1000:1000

# Minutos que un agente en modo guardia espera órdenes antes de quedar libre.
# Si lo cambias, vuelve a ejecutar el instalador (ajusta el timeout del hook Stop).
GUARDIA_MAX_MIN=14

# 1 = agentes simulados para probar la oficina sin Claude Code.
AI_OFFICE_DEMO=0
